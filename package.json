{
  "name": "portfolio-facu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:integration": "pnpm --filter web test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:a11y": "pnpm --filter web test:a11y",
    "test:visual": "pnpm --filter web test:visual",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:seed:dev": "pnpm --filter web db:seed:dev",
    "db:create-admin": "pnpm --filter web db:create-admin",
    "audit:reference": "node scripts/audit-reference.mjs",
    "scan:secrets": "gitleaks detect --source . --redact -v",
    "scan:secrets:no-git": "gitleaks detect --source . --no-git --redact -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  }
}
